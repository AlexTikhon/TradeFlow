# FICTIONAL EXAMPLE. Copy to backend.hcl (ignored by Git), use the state bucket created by
# ./bootstrap, then: terraform init -backend-config=backend.hcl
# The state bucket is never the document bucket.

bucket              = "tradeflow-tfstate-123456789012-eu-central-1"
key                 = "portfolio/terraform.tfstate"
region              = "eu-central-1"
encrypt             = true
use_lockfile        = true # S3-native lock object <key>.tflock; no DynamoDB table
allowed_account_ids = ["123456789012"]
