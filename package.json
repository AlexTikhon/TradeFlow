{
  "name": "tradeflow",
  "private": true,
  "description": "TradeFlow — post-trade execution platform for bulk commodity shipments",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "codegen": "pnpm --filter @tradeflow/contracts build && pnpm --filter @tradeflow/api db:generate",
    "dev": "pnpm codegen && pnpm --parallel --filter @tradeflow/contracts --filter @tradeflow/api --filter @tradeflow/web dev",
    "build": "pnpm --filter @tradeflow/api db:generate && pnpm -r build",
    "typecheck": "pnpm codegen && pnpm -r typecheck",
    "lint": "pnpm codegen && eslint .",
    "test": "pnpm codegen && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm codegen && pnpm --filter @tradeflow/e2e test:e2e",
    "test:storage": "pnpm codegen && pnpm --filter @tradeflow/api test:storage",
    "demo": "pnpm codegen && pnpm --filter @tradeflow/e2e demo",
    "demo:verify": "pnpm codegen && pnpm --filter @tradeflow/e2e demo:verify",
    "deploy:mock": "pnpm --filter @tradeflow/e2e deploy:mock",
    "deploy:verify": "pnpm --filter @tradeflow/e2e deploy:verify",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tradeflow/api db:migrate",
    "db:seed": "pnpm --filter @tradeflow/api db:seed",
    "db:reset": "pnpm --filter @tradeflow/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
