NODE_ENV=development
PORT=3000
# Interface to listen on, such as 127.0.0.1 for loopback only. Unset: every interface.
# HOST=127.0.0.1
# Exact reverse-proxy peers allowed to supply forwarding headers. Default: trust none.
# The proxy must overwrite incoming X-Forwarded-* headers; API must not be publicly reachable.
# TRUSTED_PROXY_CIDRS=172.29.0.2/32
DATABASE_URL=postgresql://tradeflow:tradeflow@localhost:5433/tradeflow
# Used by integration tests. Must point at a database whose name ends in "_test": tests truncate it.
TEST_DATABASE_URL=postgresql://tradeflow:tradeflow@localhost:5433/tradeflow_test
# Absolute lifetime of a sign-in session, in minutes (default 480 = 8 hours).
SESSION_TTL_MINUTES=480
# Sign-in attempts allowed per client address per minute (default 20). Clients behind one address
# (NAT, an untrusted proxy) share it.
SIGN_IN_ATTEMPTS_PER_MINUTE=20
# Private directory for uploaded document bytes; never served statically. Relative paths are
# resolved against the working directory. Required in production with the local driver.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_DIR=var/documents
# S3 mode uses a pre-provisioned PRIVATE bucket. Credentials use the AWS SDK chain:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (optional AWS_SESSION_TOKEN), or a workload role.
# Never put credentials in S3_ENDPOINT. Production requires HTTPS; omit endpoint for AWS S3.
# DOCUMENT_STORAGE_DRIVER=s3
# S3_BUCKET=tradeflow-documents
# S3_REGION=eu-central-1
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=tradeflow/
