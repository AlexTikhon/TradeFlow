// TradeFlow persistence model.
// Conventions: snake_case tables/columns, UUIDv7 primary keys generated by Postgres 18,
// timestamptz for instants, date for calendar dates, Decimal for quantities.
// Invariants Prisma cannot express (CHECK constraints) live in the migration SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

/// A company using TradeFlow. Organizations are the tenancy boundary.
/// They carry no intrinsic trade role: roles are per voyage (see VoyageParticipant).
model Organization {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  countryCode String   @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  voyageParticipations VoyageParticipant[]

  @@map("organizations")
}

/// A person acting on behalf of exactly one organization.
model User {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique
  fullName       String   @map("full_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Reference data (shared across tenants)
// ---------------------------------------------------------------------------

model Vessel {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  imoNumber String   @unique @map("imo_number") @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  voyages Voyage[]

  @@map("vessels")
}

model Commodity {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code String @unique
  name String

  voyages Voyage[]

  @@map("commodities")
}

model Port {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unLocode    String @unique @map("un_locode") @db.Char(5)
  name        String
  countryCode String @map("country_code") @db.Char(2)

  loadingVoyages     Voyage[] @relation("VoyageLoadPort")
  dischargingVoyages Voyage[] @relation("VoyageDischargePort")

  @@map("ports")
}

// ---------------------------------------------------------------------------
// Voyages
// ---------------------------------------------------------------------------

enum VoyageStatus {
  PLANNED
  LOADING
  IN_TRANSIT
  DISCHARGING
  COMPLETED
  CANCELLED

  @@map("voyage_status")
}

enum QuantityUnit {
  MT

  @@map("quantity_unit")
}

/// The execution record of one cargo moving on one vessel from a load port to a discharge port.
/// Root aggregate for notices, instructions, documents and messages in later milestones.
model Voyage {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference       String       @unique
  status          VoyageStatus @default(PLANNED)
  vesselId        String       @map("vessel_id") @db.Uuid
  commodityId     String       @map("commodity_id") @db.Uuid
  quantity        Decimal      @db.Decimal(14, 3)
  quantityUnit    QuantityUnit @default(MT) @map("quantity_unit")
  loadPortId      String       @map("load_port_id") @db.Uuid
  dischargePortId String       @map("discharge_port_id") @db.Uuid
  laycanStart     DateTime     @map("laycan_start") @db.Date
  laycanEnd       DateTime     @map("laycan_end") @db.Date
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  vessel        Vessel              @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  commodity     Commodity           @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  loadPort      Port                @relation("VoyageLoadPort", fields: [loadPortId], references: [id], onDelete: Restrict)
  dischargePort Port                @relation("VoyageDischargePort", fields: [dischargePortId], references: [id], onDelete: Restrict)
  participants  VoyageParticipant[]

  @@index([status, laycanStart])
  @@index([vesselId])
  @@map("voyages")
}

enum ParticipantRole {
  EXPORTER
  TRADER
  FINAL_BUYER
  SURVEYOR
  SHIPPING_AGENT

  @@map("participant_role")
}

/// An organization taking part in a voyage in a given role.
/// This is also the future access-control relation: an organization sees a voyage
/// if and only if it participates in it.
model VoyageParticipant {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voyageId       String          @map("voyage_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  role           ParticipantRole
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  voyage       Voyage       @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([voyageId, organizationId, role])
  @@index([organizationId, voyageId])
  @@map("voyage_participants")
}
