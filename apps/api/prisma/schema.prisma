// TradeFlow persistence model.
// Conventions: snake_case tables/columns, UUIDv7 primary keys generated by Postgres 18,
// timestamptz for instants, date for calendar dates, Decimal for quantities.
// Invariants Prisma cannot express (CHECK constraints) live in the migration SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

/// A company using TradeFlow. Organizations are the tenancy boundary.
/// They carry no intrinsic trade role: roles are per voyage (see VoyageParticipant).
model Organization {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  countryCode String   @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  voyageParticipations VoyageParticipant[]
  auditEvents          AuditEvent[]
  issuedNotices        Notice[]                                @relation("NoticeIssuedBy")
  acknowledgedNotices  Notice[]                                @relation("NoticeAcknowledgedBy")
  instructionRevisions DocumentaryInstructionRevision[]
  instructionAcks      DocumentaryInstructionAcknowledgement[]
  documentVersions     DocumentVersion[]
  documentReviews      DocumentReview[]

  @@map("organizations")
}

/// What a user may do on behalf of their organization (ADR 0008). A user belongs to exactly one
/// organization, so a role on the user row is organization-scoped. Least privilege by default.
enum UserRole {
  VIEWER
  OPERATOR

  @@map("user_role")
}

/// A person acting on behalf of exactly one organization.
model User {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique
  fullName       String   @map("full_name")
  role           UserRole @default(VIEWER)
  /// Argon2id hash in PHC string format. Null means the user has no password and cannot sign in.
  passwordHash   String?  @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization                            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions             Session[]
  auditEvents          AuditEvent[]
  issuedNotices        Notice[]                                @relation("NoticeIssuedBy")
  acknowledgedNotices  Notice[]                                @relation("NoticeAcknowledgedBy")
  instructionRevisions DocumentaryInstructionRevision[]
  instructionAcks      DocumentaryInstructionAcknowledgement[]
  documentVersions     DocumentVersion[]
  documentReviews      DocumentReview[]

  @@index([organizationId])
  @@map("users")
}

/// A signed-in browser session (ADR 0007). The browser holds an opaque random token in a cookie;
/// only its SHA-256 digest is stored, so a copy of this table does not yield usable sessions.
/// A session is valid while it is neither expired nor revoked.
model Session {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Reference data (shared across tenants)
// ---------------------------------------------------------------------------

model Vessel {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  imoNumber String   @unique @map("imo_number") @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  voyages Voyage[]

  @@map("vessels")
}

model Commodity {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code String @unique
  name String

  voyages Voyage[]

  @@map("commodities")
}

model Port {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unLocode    String @unique @map("un_locode") @db.Char(5)
  name        String
  countryCode String @map("country_code") @db.Char(2)

  loadingVoyages     Voyage[] @relation("VoyageLoadPort")
  dischargingVoyages Voyage[] @relation("VoyageDischargePort")

  @@map("ports")
}

// ---------------------------------------------------------------------------
// Voyages
// ---------------------------------------------------------------------------

enum VoyageStatus {
  PLANNED
  LOADING
  IN_TRANSIT
  DISCHARGING
  COMPLETED
  CANCELLED

  @@map("voyage_status")
}

enum QuantityUnit {
  MT

  @@map("quantity_unit")
}

/// The execution record of one cargo moving on one vessel from a load port to a discharge port.
/// Root aggregate for notices, instructions, documents and messages in later milestones.
model Voyage {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference       String       @unique
  status          VoyageStatus @default(PLANNED)
  vesselId        String       @map("vessel_id") @db.Uuid
  commodityId     String       @map("commodity_id") @db.Uuid
  quantity        Decimal      @db.Decimal(14, 3)
  quantityUnit    QuantityUnit @default(MT) @map("quantity_unit")
  loadPortId      String       @map("load_port_id") @db.Uuid
  dischargePortId String       @map("discharge_port_id") @db.Uuid
  laycanStart     DateTime     @map("laycan_start") @db.Date
  laycanEnd       DateTime     @map("laycan_end") @db.Date
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  vessel                  Vessel                   @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  commodity               Commodity                @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  loadPort                Port                     @relation("VoyageLoadPort", fields: [loadPortId], references: [id], onDelete: Restrict)
  dischargePort           Port                     @relation("VoyageDischargePort", fields: [dischargePortId], references: [id], onDelete: Restrict)
  participants            VoyageParticipant[]
  /// The trade string, as its sale contracts (see TradeContract).
  tradeContracts          TradeContract[]
  notices                 Notice[]
  documentaryInstructions DocumentaryInstruction[]
  documents               Document[]
  auditEvents             AuditEvent[]

  @@index([status, laycanStart])
  @@index([vesselId])
  @@map("voyages")
}

enum ParticipantRole {
  EXPORTER
  TRADER
  FINAL_BUYER
  SURVEYOR
  SHIPPING_AGENT

  @@map("participant_role")
}

/// An organization taking part in a voyage in a given role.
/// This is also the access-control relation (ADR 0006): an organization sees a voyage
/// if and only if it participates in it.
model VoyageParticipant {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voyageId       String          @map("voyage_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  role           ParticipantRole
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  voyage       Voyage          @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sales        TradeContract[] @relation("TradeContractSeller")
  purchases    TradeContract[] @relation("TradeContractBuyer")

  @@unique([voyageId, organizationId, role])
  // Target of the trade contracts' composite foreign keys, so a contract can only name
  // participants of its own voyage.
  @@unique([voyageId, id])
  @@index([organizationId, voyageId])
  @@map("voyage_participants")
}

// ---------------------------------------------------------------------------
// Trade string
// ---------------------------------------------------------------------------

/// One sale contract in a voyage's trade string: the seller sells the cargo to the buyer.
/// The string is the voyage's contracts in `position` order (1 = the exporter's sale), each
/// buyer being the next contract's seller, ending at the final buyer. Rules about single rows
/// are enforced by the database (here and in the migration SQL); rules about the chain as a
/// whole live in the voyages module (`trade-string.ts`).
///
/// Topology only. Commercial terms and the parties' own contract references are confidential
/// to the two counterparties and are deliberately not modelled yet (ADR 0010).
model TradeContract {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voyageId            String   @map("voyage_id") @db.Uuid
  /// 1-based place in the string. Positive (CHECK) and unique per voyage.
  position            Int
  sellerParticipantId String   @map("seller_participant_id") @db.Uuid
  buyerParticipantId  String   @map("buyer_participant_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voyage                  Voyage                   @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  // Composite keys pin both counterparties to this contract's voyage. NO ACTION (checked at the
  // end of the statement) lets a voyage deletion cascade to participants and contracts together,
  // while still refusing to delete a participant that a contract names.
  seller                  VoyageParticipant        @relation("TradeContractSeller", fields: [voyageId, sellerParticipantId], references: [voyageId, id], onDelete: NoAction, onUpdate: NoAction)
  buyer                   VoyageParticipant        @relation("TradeContractBuyer", fields: [voyageId, buyerParticipantId], references: [voyageId, id], onDelete: NoAction, onUpdate: NoAction)
  notices                 Notice[]
  // At most one: `documentary_instructions.trade_contract_id` is unique.
  documentaryInstructions DocumentaryInstruction[]
  documents               Document[]

  @@unique([voyageId, position])
  // Target of the notices' composite foreign key, so a notice stays inside its contract's voyage.
  @@unique([voyageId, id])
  // A participant sells at most once and buys at most once per voyage: the string cannot branch.
  @@unique([voyageId, sellerParticipantId])
  @@unique([voyageId, buyerParticipantId])
  @@map("trade_contracts")
}

/// Hands out voyage reference numbers (`TF-<year>-<number>`), one row per year. Taking a number
/// increments the row inside the creating transaction: concurrent creations queue on the row
/// lock, and a rolled-back creation gives its number back, so references are unique and gapless.
model VoyageReferenceCounter {
  year       Int @id
  lastNumber Int @map("last_number")

  @@map("voyage_reference_counters")
}

// ---------------------------------------------------------------------------
// Notices
// ---------------------------------------------------------------------------

/// One type so far. A second type with different fields will revisit how type-specific
/// columns are stored (ADR 0011).
enum NoticeType {
  ETA

  @@map("notice_type")
}

/// Persisted workflow state. "Overdue" is not a state: it is derived from the deadline while a
/// notice is ISSUED, so nothing has to run when a deadline passes (ADR 0011).
enum NoticeStatus {
  ISSUED
  ACKNOWLEDGED

  @@map("notice_status")
}

/// A notice from the seller to the buyer under one sale contract (ADR 0011). Readable only by
/// the contract's two counterparties; owned by the notices module. What the seller issued never
/// changes: a trigger refuses updates to the issued columns, and an acknowledged notice cannot
/// change at all. Issuer, acknowledger and both times come from the server, never the request.
model Notice {
  id                           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voyageId                     String       @map("voyage_id") @db.Uuid
  tradeContractId              String       @map("trade_contract_id") @db.Uuid
  type                         NoticeType
  status                       NoticeStatus @default(ISSUED)
  estimatedArrivalAt           DateTime     @map("estimated_arrival_at") @db.Timestamptz(3)
  /// The buyer is asked to acknowledge by then. Later than issuedAt, not later than the arrival.
  acknowledgementDueAt         DateTime     @map("acknowledgement_due_at") @db.Timestamptz(3)
  /// Optional free text, at most 1000 characters and never blank (CHECK).
  message                      String?
  issuedByUserId               String       @map("issued_by_user_id") @db.Uuid
  issuedByOrganizationId       String       @map("issued_by_organization_id") @db.Uuid
  /// Set by the API when the notice is issued; never accepted from a client.
  issuedAt                     DateTime     @map("issued_at") @db.Timestamptz(3)
  /// Set together with the status, by one conditional update (all null while ISSUED; CHECK).
  acknowledgedByUserId         String?      @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedByOrganizationId String?      @map("acknowledged_by_organization_id") @db.Uuid
  acknowledgedAt               DateTime?    @map("acknowledged_at") @db.Timestamptz(3)

  voyage                     Voyage        @relation(fields: [voyageId], references: [id], onDelete: Restrict)
  // Composite key: the notice's voyage is its contract's voyage, whoever writes the row. A
  // contract with notices cannot be deleted.
  tradeContract              TradeContract @relation(fields: [voyageId, tradeContractId], references: [voyageId, id], onDelete: Restrict, onUpdate: NoAction)
  issuedByUser               User          @relation("NoticeIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  issuedByOrganization       Organization  @relation("NoticeIssuedBy", fields: [issuedByOrganizationId], references: [id], onDelete: Restrict)
  acknowledgedByUser         User?         @relation("NoticeAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: Restrict)
  acknowledgedByOrganization Organization? @relation("NoticeAcknowledgedBy", fields: [acknowledgedByOrganizationId], references: [id], onDelete: Restrict)

  @@index([voyageId, tradeContractId])
  @@index([issuedByUserId])
  @@index([acknowledgedByUserId])
  @@map("notices")
}

// ---------------------------------------------------------------------------
// Documentary instructions
// ---------------------------------------------------------------------------

/// Documentary instructions from the buyer to the seller under one sale contract (ADR 0012): the
/// aggregate. At most one per contract (unique), so concurrent first instructions cannot both be
/// created. Its content lives in immutable revisions; this row says which revision is current
/// and carries the concurrency version. Owned by the documentary-instructions module.
///
/// `version` advances by exactly one on every change (a revision or an acknowledgement) and is
/// the entity tag clients send in `If-Match`. `currentRevisionNumber` advances by one with each
/// revision. Every change is one conditional UPDATE of this row; a trigger refuses any other
/// kind of change, and a deferred constraint trigger requires the current revision to exist.
model DocumentaryInstruction {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voyageId              String   @map("voyage_id") @db.Uuid
  tradeContractId       String   @unique @map("trade_contract_id") @db.Uuid
  version               Int      @default(1)
  currentRevisionNumber Int      @default(1) @map("current_revision_number")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  voyage           Voyage                                  @relation(fields: [voyageId], references: [id], onDelete: Restrict)
  // Composite key: the instruction's voyage is its contract's voyage, whoever writes the row. A
  // contract with instructions cannot be deleted.
  tradeContract    TradeContract                           @relation(fields: [voyageId, tradeContractId], references: [voyageId, id], onDelete: Restrict, onUpdate: NoAction)
  revisions        DocumentaryInstructionRevision[]
  acknowledgements DocumentaryInstructionAcknowledgement[]
  documents        Document[]

  // Target of the documents' composite foreign key, so a document's instruction is the one under
  // its own contract.
  @@unique([id, tradeContractId])
  @@index([voyageId])
  @@map("documentary_instructions")
}

/// One revision of an instruction, as the buyer wrote it. Never changes: a trigger refuses every
/// UPDATE. Numbered 1, 2, 3, ... per instruction, and only ever inserted as the instruction's
/// current revision (trigger), so the numbers have no gaps.
model DocumentaryInstructionRevision {
  id                      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  instructionId           String   @map("instruction_id") @db.Uuid
  revisionNumber          Int      @map("revision_number")
  /// Name and address lines; at most 500 characters and never blank (CHECK).
  consignee               String
  /// Optional; the same bounds as the consignee (CHECK).
  notifyParty             String?  @map("notify_party")
  /// `[{ document, originals, copies }]`: one to eight entries, each document once, counts
  /// 0..10 and not both zero. Validated by the API and again by a CHECK constraint.
  requirements            Json
  createdByUserId         String   @map("created_by_user_id") @db.Uuid
  createdByOrganizationId String   @map("created_by_organization_id") @db.Uuid
  /// Set by the API from its clock; never accepted from a client.
  createdAt               DateTime @map("created_at") @db.Timestamptz(3)

  instruction           DocumentaryInstruction                 @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  createdByUser         User                                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByOrganization Organization                           @relation(fields: [createdByOrganizationId], references: [id], onDelete: Restrict)
  acknowledgement       DocumentaryInstructionAcknowledgement?
  documents             Document[]

  @@unique([instructionId, revisionNumber])
  @@index([createdByUserId])
  @@map("documentary_instruction_revisions")
}

/// The seller's acknowledgement of one exact revision. At most one per revision (unique), only
/// of the instruction's current revision at the time (trigger), and never changed afterwards. A
/// later revision starts unacknowledged; earlier acknowledgements remain.
model DocumentaryInstructionAcknowledgement {
  id                           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  instructionId                String   @map("instruction_id") @db.Uuid
  revisionNumber               Int      @map("revision_number")
  acknowledgedByUserId         String   @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedByOrganizationId String   @map("acknowledged_by_organization_id") @db.Uuid
  /// Set by the API from its clock; never accepted from a client.
  acknowledgedAt               DateTime @map("acknowledged_at") @db.Timestamptz(3)

  instruction                DocumentaryInstruction         @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  revision                   DocumentaryInstructionRevision @relation(fields: [instructionId, revisionNumber], references: [instructionId, revisionNumber], onDelete: Cascade, onUpdate: NoAction)
  acknowledgedByUser         User                           @relation(fields: [acknowledgedByUserId], references: [id], onDelete: Restrict)
  acknowledgedByOrganization Organization                   @relation(fields: [acknowledgedByOrganizationId], references: [id], onDelete: Restrict)

  @@unique([instructionId, revisionNumber])
  @@index([acknowledgedByUserId])
  @@map("documentary_instruction_acknowledgements")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

/// The document types a revision of documentary instructions can require (the contract's
/// REQUIRED_DOCUMENT_TYPES). The requirements JSON of a revision holds the same names.
enum DocumentType {
  BILL_OF_LADING
  COMMERCIAL_INVOICE
  CERTIFICATE_OF_ORIGIN
  PHYTOSANITARY_CERTIFICATE
  WEIGHT_CERTIFICATE
  QUALITY_CERTIFICATE
  FUMIGATION_CERTIFICATE
  INSURANCE_CERTIFICATE

  @@map("document_type")
}

/// A document the seller presents under one sale contract (ADR 0013), for one document type that
/// one exact revision of the contract's documentary instructions requires. At most one per
/// (contract, revision, type); owned by the documents module. Its content lives in immutable
/// versions, the buyer's decisions in immutable reviews (ADR 0014); this row says which version
/// is current and carries the concurrency version.
///
/// `version` advances by exactly one on every change (an upload or a review) and is the entity
/// tag clients send in `If-Match`. `currentVersionNumber` counts uploads only: it advances by one
/// with each upload. Every change is one conditional UPDATE of this row. Triggers accept a
/// document, each new version and each review only while its revision is the instruction's
/// current revision; deferred constraint triggers require the current version to exist, and the
/// version to equal uploads plus reviews, at commit.
model Document {
  id                   String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voyageId             String       @map("voyage_id") @db.Uuid
  tradeContractId      String       @map("trade_contract_id") @db.Uuid
  instructionId        String       @map("instruction_id") @db.Uuid
  revisionNumber       Int          @map("revision_number")
  documentType         DocumentType @map("document_type")
  version              Int          @default(1)
  currentVersionNumber Int          @default(1) @map("current_version_number")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)

  voyage        Voyage                         @relation(fields: [voyageId], references: [id], onDelete: Restrict)
  // Composite keys pin the document inside its contract's voyage, to the instruction under that
  // same contract, and to an existing revision of it. None cascades: a contract, instruction or
  // revision that documents were presented against cannot be deleted from under them.
  tradeContract TradeContract                  @relation(fields: [voyageId, tradeContractId], references: [voyageId, id], onDelete: Restrict, onUpdate: NoAction)
  instruction   DocumentaryInstruction         @relation(fields: [instructionId, tradeContractId], references: [id, tradeContractId], onDelete: Restrict, onUpdate: NoAction)
  revision      DocumentaryInstructionRevision @relation(fields: [instructionId, revisionNumber], references: [instructionId, revisionNumber], onDelete: Restrict, onUpdate: NoAction)
  versions      DocumentVersion[]

  @@unique([tradeContractId, revisionNumber, documentType])
  @@index([voyageId, tradeContractId])
  @@index([instructionId, revisionNumber])
  @@map("documents")
}

/// One uploaded file of a document. Never changes: a trigger refuses every UPDATE. Numbered 1, 2,
/// 3, ... per document, and only ever inserted as the document's current version (trigger). The
/// bytes live in private storage under `storageKey`, which the server generates; the client's
/// file name is kept for display only and never names anything in storage.
model DocumentVersion {
  id                       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId               String   @map("document_id") @db.Uuid
  versionNumber            Int      @map("version_number")
  /// Where the bytes are in document storage: a server-generated UUID (CHECK), unique.
  storageKey               String   @unique @map("storage_key")
  /// For display: at most 255 characters, no path separators or control characters (CHECK).
  fileName                 String   @map("file_name")
  /// `application/pdf` only (CHECK).
  mediaType                String   @map("media_type")
  /// 1 byte to 10 MiB (CHECK).
  sizeBytes                Int      @map("size_bytes")
  /// SHA-256 of the bytes as received: exactly 32 bytes (CHECK).
  sha256                   Bytes
  uploadedByUserId         String   @map("uploaded_by_user_id") @db.Uuid
  uploadedByOrganizationId String   @map("uploaded_by_organization_id") @db.Uuid
  /// Set by the API from its clock; never accepted from a client.
  uploadedAt               DateTime @map("uploaded_at") @db.Timestamptz(3)

  document               Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedByUser         User            @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedByOrganization Organization    @relation(fields: [uploadedByOrganizationId], references: [id], onDelete: Restrict)
  review                 DocumentReview?

  @@unique([documentId, versionNumber])
  @@index([uploadedByUserId])
  @@map("document_versions")
}

/// What the buyer decided about a document version (ADR 0014).
enum DocumentReviewDecision {
  APPROVED
  REJECTED

  @@map("document_review_decision")
}

/// The buyer's decision on one exact file version. At most one per version (unique): a decision
/// is terminal, never updated (trigger) and never reopened. Only the document's current version,
/// under the instruction's current revision, can be reviewed (trigger). A replacement starts
/// without a review; decisions on earlier versions stay attached to them. Reviewer, organization
/// and time come from the server, never the request.
model DocumentReview {
  id                       String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId               String                 @map("document_id") @db.Uuid
  versionNumber            Int                    @map("version_number")
  decision                 DocumentReviewDecision
  /// Required for a rejection (1 to 1000 characters, not blank), absent for an approval (CHECK).
  reason                   String?
  reviewedByUserId         String                 @map("reviewed_by_user_id") @db.Uuid
  reviewedByOrganizationId String                 @map("reviewed_by_organization_id") @db.Uuid
  /// Set by the API from its clock; never accepted from a client.
  reviewedAt               DateTime               @map("reviewed_at") @db.Timestamptz(3)

  // The exact file version decided on. Cascades only so the demo seed can remove its documents
  // wholesale, as versions cascade from documents; no endpoint deletes anything.
  documentVersion        DocumentVersion @relation(fields: [documentId, versionNumber], references: [documentId, versionNumber], onDelete: Cascade, onUpdate: NoAction)
  reviewedByUser         User            @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedByOrganization Organization    @relation(fields: [reviewedByOrganizationId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([reviewedByUserId])
  @@map("document_reviews")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

enum AuditAction {
  VOYAGE_CREATED
  NOTICE_ISSUED
  NOTICE_ACKNOWLEDGED
  DOCUMENTARY_INSTRUCTION_REVISED
  DOCUMENTARY_INSTRUCTION_ACKNOWLEDGED
  DOCUMENT_VERSION_UPLOADED
  DOCUMENT_VERSION_REVIEWED

  @@map("audit_action")
}

/// An append-only record of a business action, written in the same transaction as the action
/// itself (ADR 0009): if the event cannot be stored, the action does not happen. The actor and
/// time come from the server (the signed-in principal and the API's clock), never from the
/// request. Updates and deletes are refused by a trigger (see the migration SQL).
model AuditEvent {
  id                  String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  action              AuditAction
  actorUserId         String      @map("actor_user_id") @db.Uuid
  actorOrganizationId String      @map("actor_organization_id") @db.Uuid
  voyageId            String      @map("voyage_id") @db.Uuid
  /// Set by the server when the event is written; never accepted from a client.
  occurredAt          DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Action-specific facts. VOYAGE_CREATED: the voyage as created. NOTICE_ISSUED: the notice as
  /// issued. NOTICE_ACKNOWLEDGED: the notice, its contract, when, and whether it was late.
  /// DOCUMENTARY_INSTRUCTION_REVISED: the instruction, its contract, the revision as written and
  /// the new version. DOCUMENTARY_INSTRUCTION_ACKNOWLEDGED: the instruction, its contract, the
  /// revision acknowledged, when, and the new version. DOCUMENT_VERSION_UPLOADED: the document,
  /// its contract, instruction revision and type, and the version as stored (number, file name,
  /// media type, size, SHA-256, time), and since ADR 0014 the document's new version.
  /// DOCUMENT_VERSION_REVIEWED: the document, its contract, instruction revision and type, the
  /// file version decided on and its SHA-256, the decision, the reason, when, and the new version.
  payload             Json

  actorUser         User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorOrganization Organization @relation(fields: [actorOrganizationId], references: [id], onDelete: Restrict)
  voyage            Voyage       @relation(fields: [voyageId], references: [id], onDelete: Restrict)

  @@index([voyageId, occurredAt])
  @@index([actorUserId])
  @@index([actorOrganizationId])
  @@map("audit_events")
}
