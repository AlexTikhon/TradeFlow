{
  "name": "@tradeflow/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Real-browser smoke tests: Chromium against the built web app, the Nest API and PostgreSQL",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "demo": "node --import tsx demo/demo.ts",
    "demo:verify": "playwright test --config demo/playwright.config.ts",
    "deploy:mock": "node --import tsx deploy/mock.ts",
    "deploy:verify": "playwright test --config deploy/playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tradeflow/contracts": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
